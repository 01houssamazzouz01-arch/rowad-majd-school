# متغيرات البيئة — انسخ هذا الملف إلى .env واملأ القيم

# مسار قاعدة البيانات (للتطوير المحلي مع SQLite)
DATABASE_URL="file:./db/custom.db"

# للنشر على Vercel — استخدم PostgreSQL من Neon
# DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# مفتاح سري لتوقيع جلسات JWT (اكتب أي نص طويل وعشوائي)
AUTH_SECRET="change-this-to-a-random-long-secret-key-2026"
